 "poems": [
  {
   "seq": "1",
   "text": "内にて殿上の人〓〓哥よむときこゆるに宮つかへ人の",
   "kana": "",
   "speaker": "",
   "page": 621,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "もとにけさうのうたよみてやれとおほせ〓とにて",
   "kana": "",
   "speaker": "",
   "page": 621,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "思ひあまりいかてもらさむおく山のいはかきこむる谷の下水",
   "kana": "",
   "speaker": "",
   "page": 621,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "なこの海の浦へにおふる濵つゝらたえま苦しき物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "濵つゝらたえま〓〓を歎かせてくるしと思ふも我こゝろそは",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "かすならて世に住の江のみをつくしいつを待ともなき身成鳬",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "流れても逢瀨はたえし住の江の身を盡してもくちはてゝなん",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "人しれぬ思ひありそのはま風に波のよるこそいはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "音にきくたかしの濵のあた浪はかけしや袖のぬれもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "忍ふれと物思ふ人はうき雲の空に戀する名をのみそたつ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "こひすともいかてか空になはたてし忍ふる程は袖につゝまて",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "又同じ月の七日にありつる女房のもとに戀の哥よみて",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "郭公まつにつけてもさゝかにのいつれの世にかしるきとそ思",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "つらしともいさやいかゝは石し水あふせまたきにたゆる心は",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "世〓ふとも絕しとそ思ふ神かきのいはれをくゝる水の心は",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "思ひやれとはて程ふる五月雨にひとりやともる袖のしつくを",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よとゝもにさてのみこそはすくしゝか思ひ知りぬや袖の雫を",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "きてなれしたもとは人にみせてましつらき涙の色のかはらは",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "忍ふ草しのふる程のよかれにはなにゝ心も袖もぬるらむ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "人しれぬ袖そ露けきあふ〓ははれれのみ增る山のした草",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "おく山のしたかけ草はかれやする軒はにのみはをのれ成つゝ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "恨かねさよの衣を人しれすおもひかへせとなくさまぬかな",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ひたすらにさ夜の衣にことよせてうらなき人を恨さらなむ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "たまさかに相坂山のまくすはらまたうらわかし恨はてしな",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "夏山の下はふくすのうらわかみまたきに露の心をくらむ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "うきなから人をつらしとしりぬれはことはりなくも落る淚か",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かりそめのたえまをさへや恨むへきことはりなきは淚成けり",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "つらきをは思ひいれしと思へとも身をしる雨のところせき哉",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "思はすにふりそふ雨のなけきをはみ笠の山をさしてちかはむ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "逢瀨をは流れてとこそたのめしかいかにとたにも音なしの瀧",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "すみ侘る名を流さしとつゝむまにしはしよとむそ音なしの瀧",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "思ひ侘しなむとなしになけく覽後の世にしもあはし物ゆへ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "人しれす落る淚にしほれつゝ戀にそ袖のかはかさりける",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "さらぬたに涙のかるゝわか袖をかくなぬらしそ道芝のつゆ",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "三島江のかりそめにたにまこも草ゆふてもあまる戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "思ひ侘しほたれぬれはあまの住あしの丸やのけふりとそなる",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "人しれぬ戀は年月へぬれとも打出るけふをはしめにやする",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "玉たれのこすのまとをく見てしより君に心をかけぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "心こそ思へはつらき物なれや心とものをおもふとおもへは",
   "kana": "",
   "speaker": "",
   "page": 622,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
